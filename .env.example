# 複製成 .env 再填入金鑰（.env 不會進版控）
#   Copy-Item .env.example .env

# 免費方案的金鑰（必填，除非只用付費 key）
GEMINI_API_KEY=

# 付費方案的金鑰（選填）：免費 key 當天的額度用完才會自動改用這把
# 不想花錢的那次執行，加 --no-paid
GEMINI_API_KEY_PAID=

# 其他選填設定（PowerShell 用 $env:X 設的值會優先）
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
